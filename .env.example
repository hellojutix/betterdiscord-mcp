# Токен НЕ нужен: плагин BetterDiscord читает данные из уже
# авторизованного клиента Discord. Здесь только настройки моста.

# Порт локального WebSocket-моста между Python MCP и BD-плагином.
# Должен совпадать со значением в плагине (BRIDGE_PORT).
BRIDGE_PORT=8787

# Guild that write/admin operations are restricted to. Required for
# manage_guild, admin_diagnostics, and list_all_channels. The plugin must
# also have its managedGuildId set via:
#   BdApi.Data.save("DiscordMcpBridge", "managedGuildId", "<guild id>")
MANAGED_GUILD_ID=
